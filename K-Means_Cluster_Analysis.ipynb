   "source": [
    "# Optimum value of K by Elbow method\n",
    "Error =[]\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "for i in range(1,10):\n",
    "    CL = KMeans(n_clusters = i).fit(custsales_cl2)\n",
    "    Error.append(CL.inertia_)\n",
    "\n",
    "plt.plot(range(1,10), Error)\n",
    "plt.title('Elbow method')\n",
    "plt.xlabel('No of clusters')\n",
    "plt.ylabel('Error')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "00222968-e284-4f77-9532-bc1cd07e14e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# The location of a bend in the plot is generally considered as an indicator of the appropriate number of clusters. \n",
    "# Here K=3, or 4 is a good solution.\n",
    "# The method is termed as Elbow Method"
   ]
  }
