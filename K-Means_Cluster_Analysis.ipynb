   "source": [
    "# K means clustering\n",
    "from sklearn.cluster import KMeans\n",
    "CL = KMeans(n_clusters=4)\n",
    "CL.fit(custsales_cl2)\n",
    "\n",
    "# Compute centroids\n",
    "centroids = CL.cluster_centers_\n",
    "centroids"
   ]
